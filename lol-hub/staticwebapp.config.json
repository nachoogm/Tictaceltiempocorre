{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*","/music/*","*.css","*.js","*.html","*.mp3","*.png","*.ico","*.svg"] },
  "routes": [
    { "route": "/api/group",    "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/summoner", "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/matches",  "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/match",    "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/live",     "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/lp",       "methods": ["GET","POST"], "allowedRoles": ["anonymous"] },
    { "route": "/api/scores",   "methods": ["GET","POST"], "allowedRoles": ["anonymous"] },
    { "route": "/api/cron-lp",  "methods": ["GET","POST"], "allowedRoles": ["anonymous"] },
    { "route": "/music/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/*.js",    "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/*.css",   "headers": { "Cache-Control": "public, max-age=3600" } }
  ],
  "mimeTypes": { ".json": "application/json", ".mp3": "audio/mpeg" },
  "platform": { "apiRuntime": "node:18" }
}
